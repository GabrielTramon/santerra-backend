PORT=3333
DATABASE_URL="postgresql://user:password@localhost:5432/Mydb?schema=public"

# Ambiente: local | develop | main. Na main os seeds de desenvolvimento (ex.: empresas) não rodam.
APP_ENV="local"

# Chave para assinar os tokens de acesso: no mínimo 32 caracteres, diferente em cada ambiente.
# Para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Validade do token (formato do jsonwebtoken: 15m, 12h, 1d...). Padrão: 1d.
JWT_EXPIRES_IN="1d"

# Página do front-end que recebe o link do convite (?token=...).
INVITATION_ACCEPT_URL="http://localhost:3000/convites/aceitar"

# Pasta onde ficam os arquivos enviados em /files (relativa à raiz do projeto). Padrão: uploads.
STORAGE_DIR="uploads"

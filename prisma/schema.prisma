generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommercialTripStatus {
  PENDING     @map("pendente")
  IN_PROGRESS @map("em_andamento")
  COMPLETED   @map("finalizado")
}

model Company {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  logo        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  userCompanies UserCompany[]
  roles         Role[]
  employees     Employee[]
  producers     Producer[]
  potentials    Potential[]
  resellers     Reseller[]
  events        Event[]
  actions       CommercialAction[]
  trips         CommercialTrip[]
  harvests      Harvest[]
  files         File[]
  products      Product[]
  groups        Group[]

  createdBy User? @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("CompanyUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("CompanyDeletedBy", fields: [deletedById], references: [id])

  @@index([deletedAt])
}

model Person {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  nationalId  String?   @unique
  phoneNumber String?
  email       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  user      User?
  employees Employee[]
  producers Producer[]

  createdBy User? @relation("PersonCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("PersonUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("PersonDeletedBy", fields: [deletedById], references: [id])

  @@index([deletedAt])
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  personId      String    @unique @db.Uuid
  username      String?   @unique
  passwordHash  String
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedById   String?   @db.Uuid

  person            Person        @relation(fields: [personId], references: [id])
  companyMemberships UserCompany[]

  createdCompanies Company[] @relation("CompanyCreatedBy")
  updatedCompanies Company[] @relation("CompanyUpdatedBy")
  deletedCompanies Company[] @relation("CompanyDeletedBy")

  createdPeople Person[] @relation("PersonCreatedBy")
  updatedPeople Person[] @relation("PersonUpdatedBy")
  deletedPeople Person[] @relation("PersonDeletedBy")

  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")
  deletedUsers User[] @relation("UserDeletedBy")

  createdWallets Wallet[] @relation("WalletCreatedBy")
  updatedWallets Wallet[] @relation("WalletUpdatedBy")
  deletedWallets Wallet[] @relation("WalletDeletedBy")

  createdRoles Role[] @relation("RoleCreatedBy")
  updatedRoles Role[] @relation("RoleUpdatedBy")
  deletedRoles Role[] @relation("RoleDeletedBy")

  createdEmployees Employee[] @relation("EmployeeCreatedBy")
  updatedEmployees Employee[] @relation("EmployeeUpdatedBy")
  deletedEmployees Employee[] @relation("EmployeeDeletedBy")

  createdProducers Producer[] @relation("ProducerCreatedBy")
  updatedProducers Producer[] @relation("ProducerUpdatedBy")
  deletedProducers Producer[] @relation("ProducerDeletedBy")

  createdPotentials Potential[] @relation("PotentialCreatedBy")
  updatedPotentials Potential[] @relation("PotentialUpdatedBy")
  deletedPotentials Potential[] @relation("PotentialDeletedBy")

  createdResellers Reseller[] @relation("ResellerCreatedBy")
  updatedResellers Reseller[] @relation("ResellerUpdatedBy")
  deletedResellers Reseller[] @relation("ResellerDeletedBy")

  createdEvents Event[] @relation("EventCreatedBy")
  updatedEvents Event[] @relation("EventUpdatedBy")
  deletedEvents Event[] @relation("EventDeletedBy")

  createdCommercialActions CommercialAction[] @relation("CommercialActionCreatedBy")
  updatedCommercialActions CommercialAction[] @relation("CommercialActionUpdatedBy")
  deletedCommercialActions CommercialAction[] @relation("CommercialActionDeletedBy")

  createdCommercialTrips CommercialTrip[] @relation("CommercialTripCreatedBy")
  updatedCommercialTrips CommercialTrip[] @relation("CommercialTripUpdatedBy")
  deletedCommercialTrips CommercialTrip[] @relation("CommercialTripDeletedBy")

  createdHarvests Harvest[] @relation("HarvestCreatedBy")
  updatedHarvests Harvest[] @relation("HarvestUpdatedBy")
  deletedHarvests Harvest[] @relation("HarvestDeletedBy")

  createdManufacturers Manufacturer[] @relation("ManufacturerCreatedBy")
  updatedManufacturers Manufacturer[] @relation("ManufacturerUpdatedBy")
  deletedManufacturers Manufacturer[] @relation("ManufacturerDeletedBy")

  createdProducts Product[] @relation("ProductCreatedBy")
  updatedProducts Product[] @relation("ProductUpdatedBy")
  deletedProducts Product[] @relation("ProductDeletedBy")

  createdGroups Group[] @relation("GroupCreatedBy")
  updatedGroups Group[] @relation("GroupUpdatedBy")
  deletedGroups Group[] @relation("GroupDeletedBy")

  createdFiles File[] @relation("FileCreatedBy")
  updatedFiles File[] @relation("FileUpdatedBy")
  deletedFiles File[] @relation("FileDeletedBy")

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("UserDeletedBy", fields: [deletedById], references: [id])

  @@index([deletedAt])
}

model UserCompany {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  wallets  Wallet[]
  userRoles UserRole[]

  @@unique([userId, companyId])
  @@index([companyId, deletedAt])
}

model Wallet {
  id            String    @id @default(uuid()) @db.Uuid
  value         Decimal   @default(0) @db.Decimal(14, 2)
  userCompanyId String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedById   String?   @db.Uuid

  userCompany UserCompany @relation(fields: [userCompanyId], references: [id], onDelete: Restrict)

  commercialActions CommercialAction[]

  createdBy User? @relation("WalletCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("WalletUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("WalletDeletedBy", fields: [deletedById], references: [id])

  @@index([userCompanyId, deletedAt])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  company      Company         @relation(fields: [companyId], references: [id])
  userRoles    UserRole[]
  permissions  RolePermission[]
  employeeRoles EmployeeRole[]

  createdBy User? @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("RoleDeletedBy", fields: [deletedById], references: [id])

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  roles RolePermission[]
}

model UserRole {
  roleId        String @db.Uuid
  userCompanyId String @db.Uuid

  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userCompany UserCompany @relation(fields: [userCompanyId], references: [id], onDelete: Cascade)

  @@id([roleId, userCompanyId])
  @@index([userCompanyId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Employee {
  id           String    @id @default(uuid()) @db.Uuid
  personId     String    @db.Uuid
  hiredAt     DateTime?
  terminatedAt DateTime?
  companyId    String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedById  String?   @db.Uuid

  person           Person           @relation(fields: [personId], references: [id])
  company          Company          @relation(fields: [companyId], references: [id])
  roles            EmployeeRole[]
  commercialActions CommercialAction[] @relation("CommercialActionResponsible")
  commercialTrips  CommercialTrip[]  @relation("CommercialTripResponsible")
  actionParticipants CommercialActionParticipant[]
  tripParticipants CommercialTripParticipant[]

  createdBy User? @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("EmployeeDeletedBy", fields: [deletedById], references: [id])

  @@unique([personId, companyId])
  @@index([companyId, deletedAt])
}

model EmployeeRole {
  roleId     String @db.Uuid
  employeeId String @db.Uuid

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([roleId, employeeId])
  @@index([employeeId])
}

model Potential {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  numericValue Decimal?  @db.Decimal(12, 2)
  description  String?
  companyId    String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedById  String?   @db.Uuid

  company   Company    @relation(fields: [companyId], references: [id])
  producers Producer[]

  createdBy User? @relation("PotentialCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("PotentialUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("PotentialDeletedBy", fields: [deletedById], references: [id])

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
}

model Producer {
  id          String    @id @default(uuid()) @db.Uuid
  personId    String    @db.Uuid
  potentialId String    @db.Uuid
  address     String?
  mainCrop    String?
  totalArea   Decimal?  @db.Decimal(12, 2)
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  person    Person    @relation(fields: [personId], references: [id])
  potential Potential @relation(fields: [potentialId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])

  commercialActionGuests CommercialActionProducerGuest[]
  commercialTrips       CommercialTrip[]

  createdBy User? @relation("ProducerCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ProducerUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("ProducerDeletedBy", fields: [deletedById], references: [id])

  @@unique([personId, companyId])
  @@index([companyId, deletedAt])
  @@index([potentialId])
}

model Reseller {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  registrationNumber String?
  phoneNumber      String?
  email            String?
  companyId        String    @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedById      String?   @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  commercialActionGuests CommercialActionResellerGuest[]

  createdBy User? @relation("ResellerCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ResellerUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("ResellerDeletedBy", fields: [deletedById], references: [id])

  @@unique([companyId, registrationNumber])
  @@index([companyId, deletedAt])
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
  actions CommercialAction[]

  createdBy User? @relation("EventCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("EventDeletedBy", fields: [deletedById], references: [id])

  @@index([companyId, deletedAt])
}

model CommercialAction {
  id               String    @id @default(uuid()) @db.Uuid
  description      String?
  eventId          String    @db.Uuid
  price            Decimal?  @db.Decimal(14, 2)
  initialDate      DateTime?
  finalDate        DateTime?
  walletId         String    @db.Uuid
  responsibleId    String    @db.Uuid
  companyId        String    @db.Uuid
  invoiceNumber    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?
  deletedAt        DateTime?
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedById      String?   @db.Uuid

  event       Event    @relation(fields: [eventId], references: [id])
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  responsible Employee @relation("CommercialActionResponsible", fields: [responsibleId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])

  guests      CommercialActionGuest[]
  participants CommercialActionParticipant[]
  files       FileCommercialAction[]

  createdBy User? @relation("CommercialActionCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("CommercialActionUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("CommercialActionDeletedBy", fields: [deletedById], references: [id])
}

model CommercialActionGuest {
  id                String  @id @default(uuid()) @db.Uuid
  producerId        String? @db.Uuid
  resellerId        String? @db.Uuid
  commercialActionId String @db.Uuid

  producer        Producer?        @relation(fields: [producerId], references: [id])
  reseller        Reseller?        @relation(fields: [resellerId], references: [id])
  commercialAction CommercialAction @relation(fields: [commercialActionId], references: [id])

  @@index([producerId])
  @@index([resellerId])
  @@index([commercialActionId])
}

model CommercialActionParticipant {
  id                 String @id @default(uuid()) @db.Uuid
  employeeId         String @db.Uuid
  commercialActionId String @db.Uuid

  employee         Employee         @relation(fields: [employeeId], references: [id])
  commercialAction CommercialAction @relation(fields: [commercialActionId], references: [id])

  @@unique([employeeId, commercialActionId])
}

model CommercialTrip {
  id                        String               @id @default(uuid()) @db.Uuid
  performedActionDescription String?
  followUpDetails           String?
  pendingIssuesDescription  String?
  status                    CommercialTripStatus @default(pendente)
  tripDate                  DateTime?
  expectedDate              DateTime?
  producerId                String               @db.Uuid
  responsibleId             String               @db.Uuid
  companyId                 String               @db.Uuid
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime?
  deletedAt                 DateTime?
  createdById               String?              @db.Uuid
  updatedById               String?              @db.Uuid
  deletedById               String?              @db.Uuid

  producer        Producer @relation(fields: [producerId], references: [id])
  responsible     Employee @relation("CommercialTripResponsible", fields: [responsibleId], references: [id])
  company         Company  @relation(fields: [companyId], references: [id])

  participants CommercialTripParticipant[]
  harvests     CommercialTripHarvest[]
  recommendations ProductRecommendation[]
  files        FileCommercialTrip[]

  createdBy User? @relation("CommercialTripCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("CommercialTripUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("CommercialTripDeletedBy", fields: [deletedById], references: [id])
}

model CommercialTripParticipant {
  id               String @id @default(uuid()) @db.Uuid
  employeeId       String @db.Uuid
  commercialTripId String @db.Uuid

  employee       Employee       @relation(fields: [employeeId], references: [id])
  commercialTrip CommercialTrip @relation(fields: [commercialTripId], references: [id])

  @@unique([employeeId, commercialTripId])
}

model Harvest {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  commercialTrips CommercialTripHarvest[]

  createdBy User? @relation("HarvestCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("HarvestUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("HarvestDeletedBy", fields: [deletedById], references: [id])
}

model CommercialTripHarvest {
  id               String @id @default(uuid()) @db.Uuid
  harvestId        String @db.Uuid
  commercialTripId String @db.Uuid

  harvest        Harvest        @relation(fields: [harvestId], references: [id])
  commercialTrip CommercialTrip @relation(fields: [commercialTripId], references: [id])

  @@unique([harvestId, commercialTripId])
}

model Manufacturer {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  registrationNumber String?
  phoneNumber        String?
  email              String?
  passwordHash       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime?
  deletedAt          DateTime?
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedById        String?   @db.Uuid

  products Product[]

  createdBy User? @relation("ManufacturerCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ManufacturerUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("ManufacturerDeletedBy", fields: [deletedById], references: [id])
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  price          Decimal?  @db.Decimal(14, 2)
  costPrice      Decimal?  @db.Decimal(14, 2)
  manufacturerId String    @db.Uuid
  companyId      String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedById    String?   @db.Uuid

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])
  company      Company      @relation(fields: [companyId], references: [id])

  groups          ProductGroup[]
  recommendations ProductRecommendation[]
  files           FileProduct[]

  createdBy User? @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("ProductDeletedBy", fields: [deletedById], references: [id])
}

model Group {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  companyId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  company  Company        @relation(fields: [companyId], references: [id])
  products ProductGroup[]

  createdBy User? @relation("GroupCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("GroupUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("GroupDeletedBy", fields: [deletedById], references: [id])
}

model ProductGroup {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  groupId   String @db.Uuid

  product Product @relation(fields: [productId], references: [id])
  group   Group   @relation(fields: [groupId], references: [id])

  @@unique([productId, groupId])
}

model ProductRecommendation {
  id               String @id @default(uuid()) @db.Uuid
  commercialTripId String @db.Uuid
  productId        String @db.Uuid

  commercialTrip CommercialTrip @relation(fields: [commercialTripId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])

  @@unique([commercialTripId, productId])
}

model File {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  originalName String?
  url         String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedById String?   @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  commercialActions FileCommercialAction[]
  commercialTrips   FileCommercialTrip[]
  products          FileProduct[]

  createdBy User? @relation("FileCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("FileUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("FileDeletedBy", fields: [deletedById], references: [id])
}

model FileCommercialAction {
  id                 String @id @default(uuid()) @db.Uuid
  fileId             String @db.Uuid
  commercialActionId String @db.Uuid

  file             File             @relation(fields: [fileId], references: [id])
  commercialAction CommercialAction @relation(fields: [commercialActionId], references: [id])

  @@unique([fileId, commercialActionId])
}

model FileCommercialTrip {
  id               String @id @default(uuid()) @db.Uuid
  fileId           String @db.Uuid
  commercialTripId String @db.Uuid

  file           File           @relation(fields: [fileId], references: [id])
  commercialTrip CommercialTrip @relation(fields: [commercialTripId], references: [id])

  @@unique([fileId, commercialTripId])
}

model FileProduct {
  id        String @id @default(uuid()) @db.Uuid
  fileId    String @db.Uuid
  productId String @db.Uuid

  file    File    @relation(fields: [fileId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([fileId, productId])
}
